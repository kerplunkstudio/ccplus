# cc+ Environment Configuration
# Copy this file to .env and modify as needed.
# On first run, ./ccplus will generate .env interactively if it doesn't exist.

# ============================================================================
# REQUIRED: Server Configuration
# ============================================================================

# Working directory for SDK sessions (where your code projects live)
WORKSPACE_PATH=~/Workspace

# Default model for SDK queries (sonnet, opus, haiku)
SDK_MODEL=sonnet

# Server port (default: 4000)
PORT=4000

# Host (default: 127.0.0.1)
# HOST=127.0.0.1

# Database path (default: data/ccplus.db)
# DATABASE_PATH=data/ccplus.db

# Authentication mode (default: local)
# CCPLUS_AUTH=local

# Secret key for session signing
SECRET_KEY=ccplus-dev-secret-change-me

# ============================================================================
# OPTIONAL: Update Channel
# ============================================================================

# Channel for updates: stable (production releases) or latest (bleeding edge)
CCPLUS_CHANNEL=stable

# ============================================================================
# OPTIONAL: Captain Configuration
# ============================================================================

# Auto-start Captain on server startup (default: true)
# CCPLUS_CAPTAIN_AUTO_START=true

# Captain AI model (default: claude-opus-4-6)
# CCPLUS_CAPTAIN_MODEL=claude-opus-4-6

# Captain workspace path (default: same as WORKSPACE_PATH)
# CCPLUS_CAPTAIN_WORKSPACE=~/Workspace

# Max conversation turns for Captain (default: 1000)
# CCPLUS_CAPTAIN_MAX_TURNS=1000

# Resume Captain sessions on startup (default: true)
# CCPLUS_CAPTAIN_RESUME_ON_STARTUP=true

# ============================================================================
# OPTIONAL: Telegram Bridge
# ============================================================================

# Telegram bot token (get from @BotFather)
# CCPLUS_TELEGRAM_BOT_TOKEN=your-bot-token-here

# Comma-separated list of allowed Telegram usernames (no @ prefix)
# CCPLUS_TELEGRAM_ALLOWLIST=your-username,teammate-username

# ============================================================================
# OPTIONAL: Discord Bridge (Experimental)
# ============================================================================

# Discord bot token
# CCPLUS_DISCORD_BOT_TOKEN=your-discord-token-here

# Comma-separated list of allowed Discord usernames
# CCPLUS_DISCORD_ALLOWLIST=user1,user2

# ============================================================================
# OPTIONAL: Memory & Sessions
# ============================================================================

# Enable cross-session memory (default: true)
# CCPLUS_MEMORY_ENABLED=true

# Enable memory distillation (default: true)
# CCPLUS_MEMORY_DISTILL=true

# Enable worktrees for isolated sessions (default: true)
# CCPLUS_WORKTREES=true

# Enable workflow mode (experimental, default: false)
# CCPLUS_WORKFLOW_ENABLED=false

# ============================================================================
# OPTIONAL: Voice Transcription (Telegram Voice Messages)
# ============================================================================

# Requires: brew install whisper-cpp ffmpeg
# Path to whisper-cli binary (default: whisper-cli)
# WHISPER_CLI_PATH=whisper-cli

# Path to whisper model file (auto-downloads if not set)
# WHISPER_MODEL_PATH=/path/to/ggml-base.en.bin

# Path to ffmpeg binary (default: ffmpeg)
# FFMPEG_PATH=ffmpeg

# ============================================================================
# OPTIONAL: Development & Debugging
# ============================================================================

# Log level (debug, info, warn, error - default: info)
# LOG_LEVEL=info

# CORS origins (comma-separated, for web UI access)
# CORS_ORIGINS=http://localhost:3000,http://localhost:4001

# Frontend dev server socket URL (only for frontend development)
# REACT_APP_SOCKET_URL=http://localhost:4000
